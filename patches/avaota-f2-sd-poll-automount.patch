@@ -0,0 +1,6 @@
+#!/bin/sh
+# Reuse /etc/mdev.conf and /usr/bin/hotplug.sh for SD card automount.
+[ "$1" = "start" ] || exit 0
+mkdir -p /mnt/SDCARD
+pidof mdev >/dev/null || /sbin/mdev -d
+/sbin/mdev -s
