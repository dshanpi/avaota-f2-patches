diff --git a/openwrt/openwrt/package/network/services/hostapd/Makefile b/openwrt/openwrt/package/network/services/hostapd/Makefile
--- a/openwrt/openwrt/package/network/services/hostapd/Makefile
+++ b/openwrt/openwrt/package/network/services/hostapd/Makefile
@@ -25,6 +25,7 @@
 PKG_CONFIG_DEPENDS:= \
 	CONFIG_PACKAGE_kmod-ath9k \
 	CONFIG_PACKAGE_kmod-cfg80211 \
+	CONFIG_PACKAGE_kmod-tf-rtl8189fs \
 	CONFIG_PACKAGE_hostapd \
 	CONFIG_PACKAGE_hostapd-basic \
 	CONFIG_PACKAGE_hostapd-mini \
@@ -88,7 +89,7 @@
 
 DRIVER_MAKEOPTS= \
 	CONFIG_ACS=$(CONFIG_PACKAGE_kmod-cfg80211) \
-	CONFIG_DRIVER_NL80211=$(CONFIG_PACKAGE_kmod-cfg80211) \
+	CONFIG_DRIVER_NL80211=$(if $(CONFIG_PACKAGE_kmod-tf-rtl8189fs),y,$(CONFIG_PACKAGE_kmod-cfg80211)) \
 	CONFIG_IEEE80211N=$(HOSTAPD_IEEE80211N) \
 	CONFIG_IEEE80211AC=$(HOSTAPD_IEEE80211AC) \
 	CONFIG_IEEE80211AX=$(HOSTAPD_IEEE80211AX) \
@@ -138,7 +139,7 @@
   TARGET_LDFLAGS_C += -lrt
 endif
 
-DRV_DEPENDS:=+PACKAGE_kmod-cfg80211:libnl-tiny
+DRV_DEPENDS:=+PACKAGE_kmod-cfg80211:libnl-tiny +PACKAGE_kmod-tf-rtl8189fs:libnl-tiny
 
 
 define Package/hostapd/Default
@@ -529,7 +530,7 @@
 TARGET_CFLAGS += -ffunction-sections -fdata-sections
 TARGET_LDFLAGS += -Wl,--gc-sections  -fuse-linker-plugin -lubox -lubus
 
-ifdef CONFIG_PACKAGE_kmod-cfg80211
+ifneq ($(CONFIG_PACKAGE_kmod-cfg80211)$(CONFIG_PACKAGE_kmod-tf-rtl8189fs),)
   TARGET_LDFLAGS += -lm -lnl-tiny
 endif
 
