menu "Select libisp configuration options"
depends on PACKAGE_libAWIspApi

choice
	prompt "Select compile libisp to static or dynamic library"
	depends on PACKAGE_libAWIspApi
	default libisp_compile_static_lib

config libisp_compile_static_lib
	bool "compile static lib"
	help
	  compile static libs for libisp.

config libisp_compile_dynamic_lib
	bool "compile dynamic lib"
	help
	  compile dynamic lib for libisp.

endchoice

config libisp_build_libispapi
	bool "libisp build and install libawispapi for 3rd apps"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp build and install libawispapi for 3rd apps

config libisp_build_tunning_app
	bool "libisp build awTuningApps"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp build awTuningApp

config libisp_support_fastboot
	bool "libisp support fastboot"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp support fastboot.

config libisp_software_tdm
	bool "libisp support software tdm"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp support software tdm

config libisp_enable_systrace
	bool "libisp enable systrace"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp enable systrace

config libisp_disable_af
	bool "libisp disable af"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp disable af

config libisp_use_ini_cfg
	bool "libisp use ini cfg"
	depends on PACKAGE_libAWIspApi
	default n
	help
	  libisp use ini cfg

config libisp_select_sensor
	bool "Select ISP Sensor Tuning Config"
	depends on PACKAGE_libAWIspApi
	default y
	help
	  tell eyesee-mpp-middleware the used sensor type.
	  multiple sensors can be selected in multiple mipi scenarios.

config cv2003
	bool "use sensor cv2003"
	depends on libisp_select_sensor
	default n
	help
	  cv2003 is for ipc.

