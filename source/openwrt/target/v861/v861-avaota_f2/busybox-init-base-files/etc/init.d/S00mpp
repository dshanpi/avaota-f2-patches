#!/bin/sh
#
# Load mpp modules....
#

MODULES_DIR="/lib/modules/`uname -r`"

start() {
    printf "Load mpp modules\n"
#    echo export LD_LIBRARY_PATH=/usr/lib/eyesee-mpp:/usr/lib/pdet:${LD_LIBRARY_PATH} >> /etc/profile

    insmod $MODULES_DIR/videobuf2-common.ko
    insmod $MODULES_DIR/videobuf2-memops.ko
    insmod $MODULES_DIR/videobuf2-dma-contig.ko
    insmod $MODULES_DIR/videobuf2-v4l2.ko
    insmod $MODULES_DIR/vin_io.ko
    [ -f $MODULES_DIR/actuator.ko ] && insmod $MODULES_DIR/actuator.ko
    [ -f $MODULES_DIR/dw9800_act.ko ] && insmod $MODULES_DIR/dw9800_act.ko
    [ -f $MODULES_DIR/gc4663_mipi.ko ] && insmod $MODULES_DIR/gc4663_mipi.ko
    [ -f $MODULES_DIR/gc2083_mipi.ko ] && insmod $MODULES_DIR/gc2083_mipi.ko
    [ -f $MODULES_DIR/ov13850_mipi.ko ] && insmod $MODULES_DIR/ov13850_mipi.ko
    [ -f $MODULES_DIR/gc2083_mipi_vc.ko ] && insmod $MODULES_DIR/gc2083_mipi_vc.ko
    [ -f $MODULES_DIR/sc235hai_mipi.ko ] && insmod $MODULES_DIR/sc235hai_mipi.ko
    [ -f $MODULES_DIR/gc8613_mipi.ko ] && insmod $MODULES_DIR/gc8613_mipi.ko
    [ -f $MODULES_DIR/sc231hai_mipi.ko ] && insmod $MODULES_DIR/sc231hai_mipi.ko
    [ -f $MODULES_DIR/sc2337p_mipi.ko ] && insmod $MODULES_DIR/sc2337p_mipi.ko
    [ -f $MODULES_DIR/sc485sl_mipi.ko ] && insmod $MODULES_DIR/sc485sl_mipi.ko
    [ -f $MODULES_DIR/sc635hai_mipi.ko ] && insmod $MODULES_DIR/sc635hai_mipi.ko
    [ -f $MODULES_DIR/imx681_mipi.ko ] && insmod $MODULES_DIR/imx681_mipi.ko
    [ -f $MODULES_DIR/imx766_mipi.ko ] && insmod $MODULES_DIR/imx766_mipi.ko
    [ -f $MODULES_DIR/os02g10_dvp.ko ] && insmod $MODULES_DIR/os02g10_dvp.ko
    insmod $MODULES_DIR/vin_v4l2.ko
    [ -f $MODULES_DIR/sunxi-ve.ko ] && insmod $MODULES_DIR/sunxi-ve.ko
    [ -f $MODULES_DIR/mir3da.ko ] && insmod $MODULES_DIR/mir3da.ko
}

stop() {
    printf "Unload mpp modules\n"

    [ -f $MODULES_DIR/mir3da.ko ] && rmmod $MODULES_DIR/mir3da.ko
    [ -f $MODULES_DIR/sunxi-ve.ko ] && rmmod $MODULES_DIR/sunxi-ve.ko
    rmmod $MODULES_DIR/vin_v4l2.ko
    [ -f $MODULES_DIR/gc4663_mipi.ko ] && rmmod $MODULES_DIR/gc4663_mipi.ko
    [ -f $MODULES_DIR/gc2083_mipi.ko ] && rmmod $MODULES_DIR/gc2083_mipi.ko
    [ -f $MODULES_DIR/gc2083_mipi_vc.ko ] && rmmod $MODULES_DIR/gc2083_mipi_vc.ko
    [ -f $MODULES_DIR/sc235hai_mipi.ko ] && rmmod $MODULES_DIR/sc235hai_mipi.ko
    [ -f $MODULES_DIR/sc2337p_mipi.ko ] && rmmod $MODULES_DIR/sc2337p_mipi.ko
    [ -f $MODULES_DIR/gc8613_mipi.ko ] && rmmod $MODULES_DIR/gc8613_mipi.ko
    [ -f $MODULES_DIR/sc231hai_mipi.ko ] && rmmod $MODULES_DIR/sc231hai_mipi.ko
    [ -f $MODULES_DIR/sc485sl_mipi.ko ] && rmmod $MODULES_DIR/sc485sl_mipi.ko
    [ -f $MODULES_DIR/sc635hai_mipi.ko ] && rmmod $MODULES_DIR/sc635hai_mipi.ko
    [ -f $MODULES_DIR/imx681_mipi.ko ] && rmmod $MODULES_DIR/imx681_mipi.ko
    [ -f $MODULES_DIR/imx766_mipi.ko ] && rmmod $MODULES_DIR/imx766_mipi.ko
    [ -f $MODULES_DIR/os02g10_dvp.ko ] && rmmod $MODULES_DIR/os02g10_dvp.ko
    [ -f $MODULES_DIR/actuator.ko ] && rmmod $MODULES_DIR/actuator.ko
    [ -f $MODULES_DIR/dw9800_act.ko ] && rmmod $MODULES_DIR/dw9800_act.ko
    rmmod $MODULES_DIR/vin_io.ko
    rmmod $MODULES_DIR/videobuf2-v4l2.ko
    rmmod $MODULES_DIR/videobuf2-dma-contig.ko
    rmmod $MODULES_DIR/videobuf2-memops.ko
    rmmod $MODULES_DIR/videobuf2-common.ko
}

case "$1" in
    start)
	start
	;;
    stop)
	stop
	;;
    restart|reload)
	stop
	start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
