/dts-v1/;

#include "sun252iw1p1.dtsi"
#include <dt-bindings/input/linux-event-codes.h>

/{
	board = "V861", "V861-PERF1";
	compatible = "allwinner,sun252iw1p1", "riscv,sun252iw1p1";
	aliases {
		pmu0 = &pmu0;
		standby_param = &standby_param;
	};

	standby_param: standby_param {
		compatible = "allwinner,sun252iw1-standby-param";
		vdd-sys = <0x00000001>;
		vcc-io = <0x00000004>;
		vdd-csi = <0x00000008>;
		vcc-pa = <0x00000010>;
		ext32k = <0x1>;
		standby_pmu = <&pmu0>;
		standby_pmu_twi = <2>;
		standby_pmu_pinbase = "PL";
		standby_pmu_pinctrl = <3 2>, <4 2>;
		standby_dram_param = <&dram>;
		memory-region = <&standby_param_reserved>;
		status = "okay";
	};

	reserved-memory {
		standby_param_reserved: standby_param@40fc0000 {
			reg = <0x0 0x40fc0000 0x0 0x1000>;
			no-map;
		};

		e907_dram_reserved: e907_dram@41000000 {
			reg = <0x0 0x41000000 0x0 0x200000>;
			no-map;
		};

		/*
		 * The name should be "vdev%dbuffer".
		 * Its size should be not less than
		 *     RPMSG_BUF_SIZE * (num of buffers in a vring) * 2
		 *   = 512 * (num of buffers in a vring) * 2
		 */
		rv_vdev0buffer: vdev0buffer@41200000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x41200000 0x0 0x40000>;
			no-map;
		};

		/*
		 * The name should be "vdev%dvring%d".
		 * The size of each should be not less than
		 *     PAGE_ALIGN(vring_size(num, align))
		 *   = PAGE_ALIGN(16 * num + 6 + 2 * num + (pads for align) + 6 + 8 * num)
		 *
		 * (Please refer to the vring layout in include/uapi/linux/virtio_ring.h)
		 */
		rv_vdev0vring0: vdev0vring0@41240000 {
			reg = <0x0 0x41240000 0x0 0x2000>;
			no-map;
		};

		rv_vdev0vring1: vdev0vring1@41242000 {
			reg = <0x0 0x41242000 0x0 0x2000>;
			no-map;
		};

		e907_rpbuf_reserved: e907_rpbuf@41244000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x41244000 0x0 0x80000>;
			no-map;
		};

		e907_share_irq_table: share_irq_table@412c4000 {
			reg = <0x0 0x412c4000 0x0 0x2000>;
			no-map;
		};

		e907_mem_fw: e907_mem_fw@42400000 {
			/* boot0 & uboot0 load elf addr */
			reg = <0x0 0x42400000 0x0 0x200000>;
		};

		size_pool_mem: size_pool_mem@0{
			size = <0x0 0x3200000>;
		};
	};

	size_pool@0 {
		compatible = "allwinner,sunxi-size-pool-dma";
		memory = <&size_pool_mem>;
		thrs = <128>;
		sizes = <0 51200>;
		fall_to_big_pool = <1>;
	};

	rpbuf_controller0: rpbuf_controller0@0 {
		compatible = "allwinner,rpbuf-controller";
		remoteproc = <&e907_rproc>;
		ctrl_id = <0>;
		memory-region = <&e907_rpbuf_reserved>;
		status = "okay";
	};

	reserved-irq {
		share-e907 {
			arch-name = "e907";
			memory-region = <&e907_share_irq_table>;
			/* defined by sun252iw1-share-irq-dt.h */
			share-irq =
					<1    0x1    E907_PA_IRQ_NUM    C907_PA_IRQ_NUM    0x00000000>,
					<3    0x3    E907_PC_IRQ_NUM    C907_PC_IRQ_NUM    0x00000000>,
					<4    0x4    E907_PD_IRQ_NUM    C907_PD_IRQ_NUM    0x00000000>,
					<5    0x5    E907_PE_IRQ_NUM    C907_PE_IRQ_NUM    0x00000000>,
					<6    0x6    E907_PF_IRQ_NUM    C907_PF_IRQ_NUM    0x00000000>,
					<7    0x7    E907_PG_IRQ_NUM    C907_PG_IRQ_NUM    0x00000000>,
					<8    0x8    E907_PH_IRQ_NUM    C907_PH_IRQ_NUM    0x00000000>,
					<9    0x9    E907_PI_IRQ_NUM    C907_PI_IRQ_NUM    0x00000000>,
					<12   0xc    E907_PL_IRQ_NUM    C907_PL_IRQ_NUM    0x00000000>;
		};
	};

	pm_msgbox:pm_msgbox@1 {
		compatible = "allwinner,sun252iw1-pm-msgbox";
		mboxes = <&msgbox 2>;
		mbox-names = "pm-msgbox";
		status = "okay";
	};
};

&cpu0 {
	cpu-supply = <&reg_axp333_dcdc1>;
};

&cluster0_opp_table {
	opp@1368000000 {
		status = "okay";
	};
	opp@1416000000 {
		status = "okay";
	};
};

&ve {
	ve-supply = <&reg_axp333_dcdc1>;
};

&pio {
	uart0_pins_active: uart0_pins@0 {
		pins = "PH9", "PH10";
		function = "uart0";
	};

	uart0_pins_sleep: uart0_pins@1 {
		pins = "PH9", "PH10";
		function = "io_disabled";
	};

	uart1_pins_active: uart1_pins@0 {
		pins = "PG4", "PG5", "PG6", "PG7";
		function = "uart1";
	};

	uart1_pins_sleep: uart1_pins@1 {
		pins = "PG4", "PG5", "PG6", "PG7";
		function = "io_disabled";
	};

	uart2_pins_active: uart2_pins@0 {
		pins = "PH5", "PH6", "PH7", "PH8";
		function = "uart2";
	};

	uart2_pins_sleep: uart2_pins@1 {
		pins = "PH5", "PH6", "PH7", "PH8";
		function = "io_disabled";
	};

	uart3_pins_active: uart3_pins@0 {
		pins = "PH0", "PH1";
		function = "uart3";
	};

	uart3_pins_sleep: uart3_pins@1 {
		pins = "PH0", "PH1";
		function = "io_disabled";
	};

	spi0_pins_default: spi0@0 {
		pins = "PC0", "PC2", "PC3"; /* clk, mosi, miso */
		function = "spi0";
		allwinner,drive = <1>;
	};

	spi0_pins_cs: spi0@1 {
		pins = "PC1", "PC4", "PC5"; /* cs, wp, hold */
		function = "spi0";
		allwinner,drive = <1>;
		bias-pull-up;
	};

	spi0_pins_sleep: spi0@3 {
		pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
		function = "io_disabled";
	};

	spi1_pins_default: spi1@0 {
		pins = "PD1", "PD2", "PD3"; /* CS, SCK, SDA */
		function = "spi1";
		allwinner,drive = <3>;
		bias-pull-up;
	};

	spi1_pins_sleep: spi1@1 {
		pins = "PD1", "PD2", "PD3";
		function = "io_disabled";
		allwinner,drive = <0>;
		bias-disable;
	};

	dbi1_pins_default: dbi1@0 {
		pins = "PD1", "PD2", "PD3", "PD5", "PD6"; /* dbi-cs, dbi-clk, dbi-sdo, dbi-dcx, dbi-te */
		function = "spi1";
		allwinner,drive = <3>;
		bias-pull-up;
	};

	dbi1_pins_sleep: dbi1@1 {
		pins = "PD1", "PD2", "PD3", "PD5", "PD6";
		function = "io_disabled";
		allwinner,drive = <0>;
		bias-disable;
	};

	spif_pins_default: spif@0 {
		pins = "PC0", "PC2", "PC3"; /* clk, mosi, miso */
		function = "spif";
		allwinner,drive = <1>;
	};

	spif_pins_cs: spif@1 {
		pins = "PC1", "PC4", "PC5"; /* cs, wp, hold */
		function = "spif";
		allwinner,drive = <1>;
		bias-pull-up;
	};

	spif_pins_sleep: spif@2 {
		pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
		function = "io_disabled";
	};

	twi0_pins_default: twi0@0 {
		pins = "PD20", "PD21";
		function = "twi0";
		bias-pull-up;
		allwinner,drive = <0>;
	};

	twi0_pins_sleep: twi0@1 {
		pins = "PD20", "PD21";
		function = "gpio_in";
	};

	twi1_pins_default: twi1@0 {
		pins = "PA15", "PA16";
		function = "twi1";
		bias-pull-up;
		allwinner,drive = <0>;
	};

	twi1_pins_sleep: twi1@1 {
		pins = "PA15", "PA16";
		function = "gpio_in";
	};

	twi2_pins_default: twi2@0 {
		pins = "PE10", "PE11";
		function = "twi2";
		bias-pull-up;
		allwinner,drive = <0>;
	};

	twi2_pins_sleep: twi2@1 {
		pins = "PE10", "PE11";
		function = "gpio_in";
	};

	twi3_pins_default: twi3@0 {
		pins = "PD18", "PD19";
		function = "twi3";
		bias-pull-up;
		allwinner,drive = <0>;
	};

	twi3_pins_sleep: twi3@1 {
		pins = "PD18", "PD19";
		function = "gpio_in";
	};

	i2s0_pins_a: i2s0@0 {
		pins = "PH0";
		function = "i2s0_mclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_b: i2s0@1 {
		pins = "PH1";
		function = "i2s0_bclk";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_c: i2s0@2 {
		pins = "PH2";
		function = "i2s0_lrck";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_d: i2s0@3 {
		pins = "PH3";
		function = "i2s0_dout0";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_e: i2s0@4 {
		pins = "PH4";
		function = "i2s0_din0";
		allwinner,drive = <1>;
		bias-disable;
	};

	i2s0_pins_f: i2s0@5 {
		pins = "PH0", "PH1", "PH2", "PH3", "PH4";
		function = "io_disabled";
		allwinner,drive = <1>;
		bias-disable;
	};

	pwm0_9_pins_active: pwm0_9@0 {
		pins = "PE9";
		function = "pwm_9";
		drive-strength = <10>;
		bias-pull-up;
	};

	pwm0_9_pins_sleep: pwm0_9@1 {
		pins = "PE9";
		function = "io_disabled";
		bias-disable;
	};

	pwm0_11_pins_active: pwm0_11@0 {
		pins = "PD12";
		function = "pwm_11";
		drive-strength = <10>;
		bias-pull-up;
	};

	pwm0_11_pins_sleep: pwm0_11@1 {
		pins = "PD12";
		function = "io_disabled";
	};

	gmac0_pins_default: gmac0@0 {
		pins = "PD1", "PD2", "PD3", "PD4", "PD5",
				"PD6", "PD7", "PD9", "PD10", "PD11";
		function = "rmii1";
		drive-strength = <40>;
	};

	gmac0_pins_sleep: gmac0@1 {
		pins = "PD1", "PD2", "PD3", "PD4", "PD5",
				"PD6", "PD7", "PD9", "PD10", "PD11";
		function = "io_disabled";
	};

	sdc0_pins_f: sdc0@5 {
		pins = "PF0", "PF1", "PF2",
			 "PF3", "PF4", "PF5";
		function = "io_disabled";
		bias-disable;
		power-source = <3300>;
	};
};

&rtc_pio {
	r_twi0_pins_default: twi0@0 {
		pins = "PL5", "PL6";
		function = "s_twi0";
		bias-pull-up;
		allwinner,drive = <0>;
	};

	r_twi0_pins_sleep: twi0@1 {
		pins = "PL5", "PL6";
		function = "gpio_in";
	};
	r_twi2_pins_default: r_twi2@0 {
		pins = "PL3", "PL4";
		function = "s_twi2";
		bias-pull-up;
		allwinner,drive = <0>;
	};
	r_twi2_pins_sleep: r_twi2@1 {
		pins = "PL3", "PL4";
		function = "gpio_in";
	};
};

&soc {
	auto_print@54321 {
		reg = <0x0 0x54321 0x0 0x0>;
		device_type = "auto_print";
		status = "okay";
	};
};

&wakeup_io {
	status = "okay";
	reg = <0x0 0x07090250 0x0 0X1000>;
	wakeup_pins {
		wakeup_pin1:wakeup-pin@1 {
			gpio_info = <&rtc_pio PL 4 GPIO_ACTIVE_HIGH>;
			edge_mode = "positive";
			clk_src = <0>;
			debounce_us = <50000>;
			wakeup-source;
			status = "okay";
		};
	};
};

&uart0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart0_pins_active>;
	pinctrl-1 = <&uart0_pins_sleep>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart1_pins_active>;
	pinctrl-1 = <&uart1_pins_sleep>;
	status = "disabled";
};

&uart2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart2_pins_active>;
	pinctrl-1 = <&uart2_pins_sleep>;
	status = "disabled";
};

&uart3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart3_pins_active>;
	pinctrl-1 = <&uart3_pins_sleep>;
	uart3_type = <2>;
	status = "disabled";
};

&spi0 {
	pinctrl-0 = <&spi0_pins_default &spi0_pins_cs>;
	pinctrl-1 = <&spi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	sunxi,spi-bus-mode = <SUNXI_SPI_BUS_NAND>;
	sunxi,spi-cs-mode = <SUNXI_SPI_CS_SOFT>;
	status = "okay";

	spi_board0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency=<25000000>;
		reg = <0x0>;
		spi-rx-bus-width=<0x01>;
		spi-tx-bus-width=<0x01>;
		status="okay";
	};
	spi-nand@0 {
		compatible = "spi-nand";
		spi-max-frequency=<100000000>;
		reg = <0x0>;
		spi-rx-bus-width=<0x04>;
		spi-tx-bus-width=<0x04>;
		status = "disabled";
	};
};

&spi1 {
	pinctrl-0 = <&dbi1_pins_default>;
	pinctrl-1 = <&dbi1_pins_sleep>;
	pinctrl-names = "default", "sleep";
	/*Set SUNXI_SPI_BUS_DBI when using SPI LCD*/
	sunxi,spi-bus-mode = <SUNXI_SPI_BUS_DBI>;
	sunxi,spi-cs-mode = <SUNXI_SPI_CS_AUTO>;
	/*sunxi,spi-bus-mode = <SUNXI_SPI_BUS_MASTER>;*/
	/*sunxi,spi-cs-mode = <SUNXI_SPI_CS_SOFT>;*/
	status = "disabled";

	spi_panel_spi1: slave@0 {
		device_type = "spi-panel";
		compatible = "allwinner,spi-panel";
		reg = <0x0>;
		spi-max-frequency = <100000000>;
		lcd_used = <1>;
		lcd_driver_name = "kld2844b";
		lcd_if = <1>;
		lcd_dbi_if = <4>;
		lcd_data_speed = <50>;
		lcd_spi_bus_num = <1>;
		lcd_x = <240>;
		lcd_y = <320>;
		lcd_pixel_fmt = <0>;
		lcd_dbi_fmt = <3>;
		lcd_rgb_order = <0>;
		lcd_width = <60>;
		lcd_height = <95>;
		lcd_pwm_used = <1>;
		lcd_pwm_ch = <9>;
		lcd_pwm_freq = <5000>;
		lcd_pwm_pol = <1>;
		lcd_pwm_name = "spi_backlight";
		lcd_frm = <1>;
		lcd_gamma_en = <1>;
		fb_buffer_num = <2>;
		lcd_backlight = <100>;
		lcd_fps = <60>;
		lcd_dbi_te = <0>;
		lcd_dbi_clk_mode = <0>;
		lcd_gpio_0 = <&pio PD 4 GPIO_ACTIVE_LOW>; /* reset */
		/*lcd_spi_dc_pin = <&pio PD 5 GPIO_ACTIVE_HIGH>;*/
		status = "disabled";
	};

};

&lcd_fb {
	status = "disabled";
	pwms = <&pwm0 9 5000000 0>;
	pwm-names = "spi_backlight";

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		spi_panel0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&spi_panel_spi1>;
		};
	};
};

&spif0 {
	clock-frequency = <100000000>;
	pinctrl-0 = <&spif_pins_default &spif_pins_cs>;
	pinctrl-1 = <&spif_pins_sleep>;
	pinctrl-names = "default", "sleep";
	spif-rx-bus-width = <0x4>;
	spif-tx-bus-width = <0x4>;
	//prefetch_read_mode_enabled;	/* choose prefect read mode */
	//dqs_mode_enabled;				/* choose dqs mode(nand provide clk mode) */
	dtr_mode_enabled;				/* choose double edge trigger mode */
	io_mode_enabled;				/* 1_x_x && x_x_x mode */
	status = "disabled";

	spif-nor  {
		device_type = "spi_board0";
		compatible = "spif-nor";
		spi-max-frequency = <0x5f5e100>;
		reg = <0x0>;
		status = "disabled";
	};
};

&sdc0 {
	bus-width = <4>;
	cd-gpios = <&pio PF 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	/*non-removable;*/
	/*broken-cd;*/
	/*cd-inverted*/
	/*data3-detect;*/
	card-pwr-gpios = <&pio PH 13 1 1 2 0xffffffff>;
	pinctrl-2 = <&sdc0_pins_f>;
	cd-used-24M;
	cd-set-debounce = <0x1>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	no-sdio;
	no-mmc;
	/* b2c-ecc-on; */
	sunxi-power-save-mode;
	/*sunxi-dis-signal-vol-sw;*/
	max-frequency = <150000000>;
	ctl-spec-caps = <0x428>;
	/*vmmc-supply = <&reg_cldo3>;*/
	/*vqmmc33sw-supply = <&reg_cldo3>;*/
	/*vdmmc33sw-supply = <&reg_cldo3>;*/
	/*vqmmc18sw-supply = <&reg_aldo4>;*/
	/*vdmmc18sw-supply = <&reg_aldo4>;*/
	status = "okay";
};

&sdc2 {
	bus-width = <4>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	sunxi-power-save-mode;
	sunxi-dis-signal-vol-sw;
	mmc-bootpart-noacc;
	cqe-on;
	ctl-cmdq-md = <0x2>;
	max-frequency = <150000000>;
	status = "disabled";
};

&e907_rproc {
	firmware-name = "amp_rv0.bin";
	mboxes = <&msgbox 0>, <&msgbox 2>;
	mbox-names = "arm-kick", "arm-standby";
	auto-boot;
	skip-shutdown;
	fw-region = <&e907_mem_fw>;
	memory-region = <&e907_dram_reserved>, <&rv_vdev0buffer>, <&rv_vdev0vring0>, <&rv_vdev0vring1>, <&e907_share_irq_table>;
	fw-partitions = "riscv0", "riscv0-r";
	fw-partition-sectors = <2432>;
	memory-mappings =
		/* < DA         len             PA >    */
		/* DRAM */
		< 0x40000000       0xBfffffff    0x40000000 >;
	stop-record-reg = <0x4a00020c>;

	share-irq = "e907";
	status = "okay";

	rproc_wdt: rproc_wdt@0 {
		timeout_ms = <6000>;
		try_times = <3>;
		reset_type = <0x2>;
		panic_on_timeout = <0>;
		status = "okay";
	};
};

&msgbox {
	status = "okay";
};

&hwspinlock {
	status = "okay";
};

/*
 * usb_port_type: usb mode. 0-device, 1-host, 2-otg.
 * usb_detect_type: usb hotplug detect mode. 0-none, 1-vbus/id detect, 2-pmu detect, 3-tcpm detect.
 * usb_detect_mode: 0-thread scan, 1-id gpio interrupt, 2-pmu notify.
 * usb_id_gpio: gpio for id detect.
 * usb_det_vbus_gpio: gpio for id detect. gpio or "axp_ctrl".
 * usb_wakeup_suspend: 0-SUPER_STANDBY, 1-USB_STANDBY.
 */
&usbc0 {
	device_type = "usbc0";
	usb_port_type = <0>;
	usb_detect_type = <1>;
	usb_detect_mode = <1>;
	usb_id_gpio = <&pio PH 2 GPIO_ACTIVE_HIGH>;
	usb_det_vbus_gpio;
	usb_wakeup_suspend = <0>;
	status = "okay";
};

&udc {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&twi0 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi0_pins_default>;
	pinctrl-1 = <&twi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	twi_drv_used = <1>;
	status = "disabled";
};

&twi1 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi1_pins_default>;
	pinctrl-1 = <&twi1_pins_sleep>;
	pinctrl-names = "default", "sleep";
	twi_drv_used = <1>;
	status = "okay";
};

&twi2 {
	clock-frequency = <400000>;
	pinctrl-0 = <&r_twi2_pins_default>;
	pinctrl-1 = <&r_twi2_pins_sleep>;
	pinctrl-names = "default", "sleep";
	twi_drv_used = <1>;
	status = "okay";

	pmu0: pmu@36{
		compatible = "x-powers,axp333";
		reg = <0x36>;
		status = "okay";
		wakeup_source;

		powerkey0: powerkey@0 {
			status = "disabled";
			compatible = "x-powers,axp2101-pek";
		};

		axp333_motor: axp333_motor@0 {
			status = "okay";
			compatible = "x-powers,axp333-motor";
		};

		ircut: ircut@0 {
			status = "okay";
			compatible = "x-powers,axp333-ircut";
		};

		regulators{
			reg_axp333_dcdc1: dcdc1 {
				regulator-name = "axp333-dcdc1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
				regulator-step-delay-us = <25>;
				regulator-final-delay-us = <50>;
				regulator-always-on;
			};

			reg_axp333_dcdc2: dcdc2 {
				regulator-name = "axp333-dcdc2";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1840000>;
				regulator-step-delay-us = <25>;
				regulator-final-delay-us = <50>;
				regulator-always-on;
			};

			reg_axp333_dcdc3: dcdc3 {
				regulator-name = "axp333-dcdc3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
				regulator-step-delay-us = <25>;
				regulator-final-delay-us = <50>;
				regulator-always-on;
			};

			reg_axp333_aldo1: aldo1 {
				regulator-name = "axp333-aldo1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3500000>;
				regulator-step-delay-us = <25>;
				regulator-final-delay-us = <50>;
				regulator-always-on;
			};

			reg_axp333_aldo2: aldo2 {
				regulator-name = "axp333-aldo2";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3500000>;
				regulator-step-delay-us = <25>;
				regulator-final-delay-us = <50>;
				regulator-always-on;
			};

			reg_axp333_rtcldo: rtcldo {
				regulator-name = "axp333-rtcldo";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1800000>;
				regulator-step-delay-us = <25>;
				regulator-final-delay-us = <50>;
				regulator-always-on;
			};
		};
		virtual-ext-dcdc1 {
			compatible = "xpower-vregulator,dcdc1";
			dcdc1-supply = <&reg_axp333_dcdc1>;
		};
		virtual-ext-dcdc2 {
			compatible = "xpower-vregulator,dcdc2";
			dcdc2-supply = <&reg_axp333_dcdc2>;
		};
		virtual-ext-dcdc3 {
			compatible = "xpower-vregulator,dcdc3";
			dcdc3-supply = <&reg_axp333_dcdc3>;
		};
		virtual-ext-aldo1 {
			compatible = "xpower-vregulator,aldo1";
			aldo1-supply = <&reg_axp333_aldo1>;
		};
		virtual-ext-aldo2 {
			compatible = "xpower-vregulator,aldo2";
			aldo2-supply = <&reg_axp333_aldo2>;
		};
		virtual-ext-rtcldo {
			compatible = "xpower-vregulator,rtcldo";
			rtcldo-supply = <&reg_axp333_rtcldo>;
		};
	};

	tlsc6x: tlsc6x@2e {
		compatible = "tlsc6x,tlsc6x_ts";
		reg = <0x2e>;
		reset-gpio = <&pio PE 4 GPIO_ACTIVE_HIGH>;
		irq-gpio = <&pio PE 8 GPIO_ACTIVE_LOW>;
		TP_MAX_X = <240>;
		TP_MAX_Y = <320>;
		revert_x_flag = <1>;
		revert_y_flag = <0>;
		exchange_x_y_flag = <1>;
		status = "disabled";
	};

};

&twi3 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi3_pins_default>;
	pinctrl-1 = <&twi3_pins_sleep>;
	pinctrl-names = "default", "sleep";
	twi_drv_used = <1>;
	status = "disabled";
};

