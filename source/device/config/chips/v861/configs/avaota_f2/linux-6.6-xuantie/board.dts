/* audio dirver module -> audio codec */
&codec {
	tx-hub-en;
	rx-sync-en;

	dac-vol		= <32>;		/* default value:32 range:0->63 */
	dacl-vol	= <129>;	/* default value:129 range:0->255 */
	adc1-vol	= <129>;	/* default value:129 range:0->255 */
	adc2-vol	= <129>;	/* default value:129 range:0->255 */
	lineoutl-vol	= <7>;		/* default value:7 range:0->7 */
	adc1-gain	= <15>;		/* default value:15 range:0->15 */
	adc2-gain	= <15>;		/* default value:15 range:0->15 */

	pa-pin-max	= <1>;
	pa-pin-0	= <&pio PH 15 GPIO_ACTIVE_HIGH>;
	pa-pin-level-0	= <1>;
	pa-pin-msleep-0	= <0>;

	status = "okay";
};

&codec_plat {
	playback-cma	= <32>;
	capture-cma	= <32>;
	status = "okay";
};

&codec_mach {
	status = "okay";
	soundcard-mach,cpu {
		sound-dai = <&codec_plat>;
	};
	soundcard-mach,codec {
		sound-dai = <&codec>;
	};
};

/* audio dirver module -> I2S/PCM */
&i2s0_plat {
	tdm-num		= <0>;
	tx-pin		= <0>;
	rx-pin		= <0>;

	pinctrl-used;
	pinctrl-names	= "default","sleep";
	pinctrl-0	= <&i2s0_pins_a &i2s0_pins_b &i2s0_pins_c &i2s0_pins_d &i2s0_pins_e>;
	pinctrl-1	= <&i2s0_pins_f>;

	tx-hub-en;
	rx-sync-en;
	playback-cma	= <32>;
	capture-cma	= <32>;
	status		= "okay";
};

&i2s0_mach {
	soundcard-mach,format		= "i2s";

	soundcard-mach,name		= "sndi2s0";
	soundcard-mach,frame-master	= <&i2s0_cpu>;
	soundcard-mach,bitclock-master	= <&i2s0_cpu>;
	/* soundcard-mach,frame-inversion; */
	/* soundcard-mach,bitclock-inversion; */
	soundcard-mach,slot-num		= <2>;
	soundcard-mach,slot-width	= <32>;
	status		= "okay";
	i2s0_cpu: soundcard-mach,cpu {
		sound-dai = <&i2s0_plat>;
		/* note: pll freq = 24.576M or 22.5792M * pll-fs */
		soundcard-mach,pll-fs	= <1>;
		/* note:
		 * mclk freq = mclk-fs * 12.288M or 11.2896M	(when mclk-fp ture)
		 * mclk freq = mclk-fs * pcm rate		(when mclk-fp false)
		 */
		soundcard-mach,mclk-fp;
		soundcard-mach,mclk-fs	= <1>;
	};

	i2s0_codec: soundcard-mach,codec {
	};
};

&pwm0_9 {
	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&pwm0_9_pins_active>;
	pinctrl-1 = <&pwm0_9_pins_sleep>;
	status = "disabled";
};

&pwm0_11 {
	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&pwm0_11_pins_active>;
	pinctrl-1 = <&pwm0_11_pins_sleep>;
	clk_bypass_25m;
	status = "okay";
};

&mdio0 {
	status = "okay";
	gmac0_phy0: ethernet-ac300-ephy {
		compatible = "ethernet-phy-id0044.1400";
		reg = <0x0>;
		max-speed = <100>;
		pwms = <&pwm0 11 40 0>;
		efuse = <&sid>;
		efuse-name = "ephy_trim";
		allwinner,leds-active-low;
		allwinner,ephy-clk-sel = <0>; /* 0-25M, 1-27M, 2-24M */
	};
};

&gmac0 {
	phy-mode = "rmii";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&gmac0_pins_default>;
	pinctrl-1 = <&gmac0_pins_sleep>;
	sunxi,phy-clk-type = <1>; /* 0-phy25m, 1-osc25m */
	tx-delay = <0>;
	rx-delay = <0>;
	phy-handle = <&gmac0_phy0>;
	status = "okay";
};

&gpadc0 {
	channel_num = <4>;
	channel_select = <0x1>;
	channel_data_select = <0x0>;
	channel_compare_select = <0x1>;
	channel_cld_select = <0x0>;
	channel_chd_select = <0x0>;
	channel0_compare_lowdata = <1200000>;
	channel0_compare_higdata = <1700000>;
	status = "okay";
	keyadc0 {
		key_cnt = <5>;
		key0_vol = <210>;
		key0_val = <KEY_VOLUMEUP>;
		key1_vol = <410>;
		key1_val = <KEY_VOLUMEDOWN>;
		key2_vol = <590>;
		key2_val = <KEY_MENU>;
		key3_vol = <750>;
		key3_val = <KEY_OK>;
		key4_vol = <880>;
		key4_val = <KEY_HOME>;
	};
};

/* VE enc freq 576M uses pll-video-4x as parent; set to 1152M (576*2)
 * so VE can do integer division. Otherwise VE changing parent
 * clock frequency may disturb TCON frame rate. */
&ccu {
	assigned-clocks = <&ccu CLK_PLL_VIDEO_4X>;
	assigned-clock-rates = <1152000000>;
};
